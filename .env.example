# ============================================================
# Autonomous IT Control Plane — Environment Configuration
# Copy this file to .env and populate with real values.
# NEVER commit .env to version control.
# ============================================================

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Database (Aurora PostgreSQL + pgvector)
DATABASE_URL=postgresql://itsm:password@localhost:5432/itsm_db
PGVECTOR_SCHEMA=itsm

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_INDEX=itsm-runbooks
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me

# SQS Queues
SQS_APPROVAL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/itsm-approvals.fifo
SQS_CHANGE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/itsm-changes.fifo

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-rsa-key
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=/etc/keys/jwt_public.pem

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","https://itsm.yourdomain.com"]

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# S3 Buckets
S3_RUNBOOK_BUCKET=itsm-runbooks-dev

# KMS
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/mrk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPA Policy Engine
OPA_URL=http://opa:8181

# Tenancy
DEFAULT_TENANT_ID=default

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=autonomous-it-control-plane

# Agent Runtime
CONFIDENCE_THRESHOLD=0.85
MAX_AGENT_ITERATIONS=10
MAX_AGENT_TOKENS=50000

# Dagster (optional, for pipeline orchestration)
DAGSTER_HOME=/opt/dagster/dagster_home
