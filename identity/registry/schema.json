{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentIdentity",
  "type": "object",
  "required": ["agent_id", "agent_type", "tier", "allowed_actions", "token_ttl_seconds"],
  "properties": {
    "agent_id": { "type": "string", "format": "uuid" },
    "agent_type": {
      "type": "string",
      "enum": ["itsm-resolver", "change-executor", "incident-manager"]
    },
    "tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
    "allowed_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "token_ttl_seconds": { "type": "integer", "minimum": 300, "maximum": 86400 },
    "max_budget_usd": { "type": "number", "minimum": 0 },
    "tenant_id": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
